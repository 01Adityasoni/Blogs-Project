<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('./partials/head') %>
    <title>Homepage</title>
</head>
<body>
    <%- include('./partials/nav') %>

    <div class="container mt-4">
        <% if (blog) { %>
            <div class="row">
                <div class="col-md-12">
                    <h1><%= blog.title %></h1>
                    <% if (blog.coverImageURL) { %>
                        <img src="<%= blog.coverImageURL %>" class="img-fluid mb-3" alt="cover">
                    <% } %>
                    <p class="lead">By <%= blog.createdBy %></p>
                    <div><%= blog.body %></div>
                </div>
            </div>

            <div class="row mt-4">
                <div class="col-md-8">
                    <h3>Comments</h3>
                    <% if (comments && comments.length) { %>
                        <% comments.forEach(function(c){ %>
                            <div class="mb-3 border p-2">
                                <strong><%= c.createdBy %></strong>
                                <div><%= c.content %></div>
                                <small class="text-muted"><%= c.timestamp %></small>
                            </div>
                        <% }) %>
                    <% } else { %>
                        <p>No comments yet.</p>
                    <% } %>

                    <% if (user) { %>
                        <form action="/comments/add" method="POST" class="mt-3">
                            <input type="hidden" name="blogTitle" value="<%= blog.title %>">
                            <div class="mb-3">
                                <label for="content" class="form-label">Add a comment</label>
                                <textarea name="content" id="content" rows="3" class="form-control" required></textarea>
                            </div>
                            <button class="btn btn-primary">Post Comment</button>
                        </form>
                    <% } else { %>
                        <p>Please <a href="/user/signin">sign in</a> to comment.</p>
                    <% } %>
                </div>
            </div>
        <% } else { %>
            <p>Blog not found.</p>
        <% } %>

    </div>

    <%- include('./partials/scripts') %>
</body>
</html>