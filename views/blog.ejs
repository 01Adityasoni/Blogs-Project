<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('./partials/head') %>
    <title>Homepage</title>
</head>
<body>
    <div class="app-shell">
    <%- include('./partials/nav') %>

    <main class="page-shell">
        <div class="container">
            <% if (blog) { %>
                <section class="surface-card mb-4">
                    <div class="row align-items-start g-4">
                        <div class="col-lg-8">
                            <span class="hero-badge mb-3">Featured read</span>
                            <h1 class="blog-title display-5 mb-3"><%= blog.title %></h1>
                            <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-3 mb-4">
                                <div class="d-flex align-items-center gap-3">
                                    <img src="<%= blog.authorProfileImageURL || '/user avatar img.png' %>" alt="author avatar" class="rounded-circle avatar-lg" onerror="this.onerror=null;this.src='/user avatar img.png'">
                                    <div>
                                        <p class="lead mb-0"><%= blog.authorFullName || blog.createdBy %></p>
                                        <small class="meta-text"><%= blog.createdBy %></small>
                                    </div>
                                </div>

                                <% if (user && user.role === 'admin') { %>
                                    <form action="/blogs/delete" method="POST" onsubmit="return confirm('Delete this blog? This will remove the post and its comments.');">
                                        <input type="hidden" name="title" value="<%= blog.title %>">
                                        <button type="submit" class="btn btn-outline-danger px-4 py-2">Delete blog</button>
                                    </form>
                                <% } %>
                            </div>
                            <div class="blog-meta fs-6 lh-lg"><%= blog.body %></div>
                        </div>
                    </div>
                </section>

                <div class="row g-4">
                    <div class="col-lg-8">
                        <section class="comment-panel">
                            <div class="d-flex align-items-center justify-content-between gap-3 mb-3">
                                <div>
                                    <h2 class="section-title h3 mb-1">Comments</h2>
                                    <p class="muted-copy mb-0"><%= comments && comments.length ? `${comments.length} replies` : 'No replies yet' %></p>
                                </div>
                            </div>

                            <% if (comments && comments.length) { %>
                                <% comments.forEach(function(c){ %>
                                    <article class="comment-panel mb-3">
                                        <div class="d-flex align-items-center justify-content-between gap-3 mb-2">
                                            <strong><%= c.createdBy %></strong>
                                            <div class="d-flex align-items-center gap-2">
                                                <small class="comment-meta"><%= c.timestamp %></small>
                                                <% if (user && user.role === 'admin') { %>
                                                    <form action="/comments/delete" method="POST" class="m-0" onsubmit="return confirm('Delete this comment?');">
                                                        <input type="hidden" name="blogTitle" value="<%= blog.title %>">
                                                        <input type="hidden" name="content" value="<%= c.content %>">
                                                        <input type="hidden" name="createdBy" value="<%= c.createdBy %>">
                                                        <input type="hidden" name="timestamp" value="<%= c.timestampValue %>">
                                                        <button type="submit" class="btn btn-sm btn-outline-danger px-2 py-1">Delete</button>
                                                    </form>
                                                <% } %>
                                            </div>
                                        </div>
                                        <div class="blog-meta"><%= c.content %></div>
                                    </article>
                                <% }) %>
                            <% } else { %>
                                <div class="empty-state">
                                    <p class="mb-0">No comments yet. Start the discussion.</p>
                                </div>
                            <% } %>

                            <% if (user) { %>
                                <form action="/comments/add" method="POST" class="mt-4">
                                    <input type="hidden" name="blogTitle" value="<%= blog.title %>">
                                    <div class="mb-3">
                                        <label for="content" class="form-label">Add a comment</label>
                                        <textarea name="content" id="content" rows="4" class="form-control" placeholder="Share a useful thought or a quick reaction" required></textarea>
                                    </div>
                                    <button class="btn btn-primary px-4 py-2">Post Comment</button>
                                </form>
                            <% } else { %>
                                <div class="empty-state mt-4 text-start">
                                    <p class="mb-0">Please <a href="/user/signin">sign in</a> to comment.</p>
                                </div>
                            <% } %>
                        </section>
                    </div>
                </div>
            <% } else { %>
                <div class="empty-state">
                    <span class="hero-badge mb-3">Missing post</span>
                    <h1 class="section-title h3 mb-2">Blog not found</h1>
                    <p class="muted-copy mb-0">The post may have been removed or the link is outdated.</p>
                </div>
            <% } %>

        </div>
    </main>
    </div>

    <%- include('./partials/scripts') %>
</body>
</html>