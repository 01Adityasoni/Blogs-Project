<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('./partials/head') %>
    <title>Homepage</title>
</head>
<body>
    <%- include('./partials/nav') %>

    <div class="container mt-4">
        <% if (blog) { %>
            <div class="row">
                <div class="col-md-12">
                    <h1><%= blog.title %></h1>
                    <div class="d-flex align-items-center gap-3 mb-3">
                        <img src="<%= blog.authorProfileImageURL || '/user avatar img.png' %>" alt="author avatar" class="rounded-circle" style="width:64px;height:64px;object-fit:cover;">
                        <div>
                            <p class="lead mb-0">By <%= blog.authorFullName || blog.createdBy %></p>
                            <small class="text-muted"><%= blog.createdBy %></small>
                        </div>
                    </div>
                    <div><%= blog.body %></div>
                </div>
            </div>

            <div class="row mt-4">
                <div class="col-md-8">
                    <h3>Comments</h3>
                    <% if (comments && comments.length) { %>
                        <% comments.forEach(function(c){ %>
                            <div class="mb-3 border p-2">
                                <strong><%= c.createdBy %></strong>
                                <div><%= c.content %></div>
                                <small class="text-muted"><%= c.timestamp %></small>
                            </div>
                        <% }) %>
                    <% } else { %>
                        <p>No comments yet.</p>
                    <% } %>

                    <% if (user) { %>
                        <form action="/comments/add" method="POST" class="mt-3">
                            <input type="hidden" name="blogTitle" value="<%= blog.title %>">
                            <div class="mb-3">
                                <label for="content" class="form-label">Add a comment</label>
                                <textarea name="content" id="content" rows="3" class="form-control" required></textarea>
                            </div>
                            <button class="btn btn-primary">Post Comment</button>
                        </form>
                    <% } else { %>
                        <p>Please <a href="/user/signin">sign in</a> to comment.</p>
                    <% } %>
                </div>
            </div>
        <% } else { %>
            <p>Blog not found.</p>
        <% } %>

    </div>

    <%- include('./partials/scripts') %>
</body>
</html>