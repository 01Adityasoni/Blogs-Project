<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('./partials/head') %>
    <title>Manage Users</title>
</head>
<body>
    <div class="app-shell">
    <%- include('./partials/nav') %>

    <main class="page-shell">
        <div class="container">
            <section class="surface-card mb-4">
                <span class="hero-badge mb-3">Admin tools</span>
                <h1 class="section-title h2 mb-2">Manage users</h1>
                <p class="muted-copy mb-0">Promote any registered user to admin from here.</p>
            </section>

            <% if (errorMessage) { %>
                <div class="alert alert-danger mb-4" role="alert"><%= errorMessage %></div>
            <% } %>

            <% if (successMessage) { %>
                <div class="alert alert-success mb-4" role="alert"><%= successMessage %></div>
            <% } %>

            <section class="surface-card p-4">
                <% if (users && users.length) { %>
                    <div class="row g-3">
                        <% users.forEach(function(account){ %>
                            <div class="col-12">
                                <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-3 p-3 rounded-4" style="background: rgba(255,255,255,0.03); border: 1px solid rgba(148,163,184,0.12);">
                                    <div class="d-flex align-items-center gap-3">
                                        <img src="<%= account.profileImageURL || '/user avatar img.png' %>" alt="user avatar" class="rounded-circle avatar-sm" onerror="this.onerror=null;this.src='/user avatar img.png'">
                                        <div>
                                            <div class="fw-semibold"><%= account.fullName || account.email %></div>
                                            <small class="meta-text"><%= account.email %></small>
                                        </div>
                                    </div>

                                    <div class="d-flex align-items-center gap-3">
                                        <span class="badge text-bg-dark border border-secondary text-uppercase"><%= account.role %></span>
                                        <% if (account.role !== 'admin') { %>
                                            <form action="/user/make-admin" method="POST" class="m-0">
                                                <input type="hidden" name="email" value="<%= account.email %>">
                                                <button type="submit" class="btn btn-outline-primary btn-sm px-3">Make admin</button>
                                            </form>
                                        <% } else { %>
                                            <span class="text-success small">Already admin</span>
                                        <% } %>
                                    </div>
                                </div>
                            </div>
                        <% }) %>
                    </div>
                <% } else { %>
                    <div class="empty-state m-0">
                        <p class="mb-0">No users found.</p>
                    </div>
                <% } %>
            </section>
        </div>
    </main>
    </div>

    <%- include('./partials/scripts') %>
</body>
</html>